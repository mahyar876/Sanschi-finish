# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/sansyar

# ── JWT ──
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Server ──
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Zarinpal ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CURRENCY=rial

# mock pay/refund in dev
ALLOW_MOCK_PAY=true
ALLOW_MOCK_REFUND=true
AUTO_REFUND=false

# ── Cancel policy (hours) ──
CANCEL_FULL_REFUND_HOURS=48
CANCEL_PARTIAL_REFUND_HOURS=24
CANCEL_PARTIAL_REFUND_PCT=50
NO_SHOW_GRACE_MIN=45

# ── SMS (Kavenegar) ──
SMS_ENABLED=false
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
