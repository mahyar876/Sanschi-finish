# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/sanschii

# ── JWT ──
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Server ──
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# مبدأهای مجاز CORS (جدا با ویرگول) — در production الزامی
# CORS_ORIGINS=https://your-frontend.example,https://www.your-frontend.example
# JSON_BODY_LIMIT=4mb
# MONGO_POOL_SIZE=50
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_PENALTY_MAX=20
# OTP_TTL_MS=300000
# OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_SEND_COOLDOWN_MS=60000
# OTP_MAX_SENDS_PER_WINDOW=5
# OTP_PEPPER=long-random-string-separate-from-jwt
# ALLOW_OWNER_MANUAL_PAY=false
# PENALTY_MIN_PLAY_MS=45000
# PENALTY_SESSION_TTL_MS=1200000
# ADMIN_SECRET=optional-header-x-admin-secret-for-scripts
# CATALOG_CACHE_MS=45000
# FLASH_CACHE_MS=45000
# SITE_SETTINGS_CACHE_MS=60000

# ── دستیار هوشمند رزرو ──
# RATE_LIMIT_ASSISTANT_MAX=30
# ASSISTANT_SESSION_TTL_MS=7200000
# ASSISTANT_SESSION_MAX=8000
# ASSISTANT_LLM_URL=
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_TIMEOUT_MS=12000

# ── Zarinpal ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CURRENCY=rial

# mock pay/refund in dev
ALLOW_MOCK_PAY=true
ALLOW_MOCK_REFUND=true
AUTO_REFUND=false

# ── Cancel policy (hours) ──
CANCEL_FULL_REFUND_HOURS=48
CANCEL_PARTIAL_REFUND_HOURS=24
CANCEL_PARTIAL_REFUND_PCT=50
NO_SHOW_GRACE_MIN=45

# ── SMS (Kavenegar) ──
SMS_ENABLED=false
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
