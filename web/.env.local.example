# آدرس API برای مرورگر — اگر خالی باشد، حالت نمایشی (دمو) فعال است
# NEXT_PUBLIC_API_URL=

# Google Maps — Maps JavaScript API + Maps Embed API (سهمیه رایگان ماهانه)
# https://console.cloud.google.com/google/maps-apis
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# غیرفعال کردن دمو وقتی API واقعی دارید:
# NEXT_PUBLIC_DEMO_MODE=false

# فقط برای next dev — پروکسی به Express (اختیاری)
# API_PROXY_TARGET=http://localhost:5000
