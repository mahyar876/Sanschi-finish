# Production: آدرس عمومی API (روی Vercel الزامی — rewrites خاموش می‌شود)
# NEXT_PUBLIC_API_URL=https://api.example.com

# Canonical URL سایت (sitemap، metadata، **لینk داخل QR رزرو**)
# Production: NEXT_PUBLIC_SITE_URL=https://sanschii.ir
# تست QR با گوشی روی وای‌فای همان شبکه (آدرس Network از npm run dev):
# NEXT_PUBLIC_SITE_URL=http://192.168.1.XX:3000

# فقط برای UI/دادهٔ کاملاً نمایشی (بدون قفل سانس روی سرور):
# NEXT_PUBLIC_DEMO_MODE=true

# Google Maps — Maps JavaScript API + Maps Embed API (سهمیه رایگان ماهانه)
# https://console.cloud.google.com/google/maps-apis
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# تماس Nominatim (جستجوی آدرس) — ایمیل واقعی در production
# NOMINATIM_CONTACT_EMAIL=you@example.com

# فقط برای next dev — پروکسی به Express (اختیاری)
# API_PROXY_TARGET=http://localhost:5000

# پرداخت ساختگی در فرانت (پیش‌فرض در npm run dev: روشن — برای production = false)
# NEXT_PUBLIC_ALLOW_MOCK_PAY=true
